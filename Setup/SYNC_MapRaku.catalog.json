[
  {
    "id": "VRAMWIZ.SYNC_MapRaku",
    "name": "SYNC 地図",
    "type": "汎用プラグイン",
    "summary": "案内図を作成し、ルート上でマーカーを移動表示",
    "description": "https://raw.githubusercontent.com/vramwiz/MapRaku/main/README.md",
    "author": "VRAMの魔術師",
    "repoURL": "https://github.com/vramwiz/MapRaku/",
    "licenses": [
      {
        "type": "不明",
        "isCustom": true,
        "copyrights": [],
        "licenseBody": ""
      }
    ],
    "tags": [
      "地図",
      "案内図",
      "ルート",
      "アニメーション"
    ],
    "dependencies": [],
    "images": [],
    "installer": {
      "source": {
        "type": "githubRelease",
        "owner": "vramwiz",
        "repo": "MapRaku",
        "pattern": "^SYNC_MapRaku\\.zip$",
        "github": {
          "owner": "vramwiz",
          "repo": "MapRaku",
          "pattern": "^SYNC_MapRaku\\.zip$"
        }
      },
      "install": [
        {
          "action": "download"
        },
        {
          "action": "extract"
        },
        {
          "action": "copy",
          "from": "{tmp}/SYNC_MapRaku",
          "to": "{pluginsDir}/SYNC_MapRaku"
        }
      ],
      "uninstall": [
        {
          "action": "delete",
          "path": "{pluginsDir}/SYNC_MapRaku"
        }
      ]
    },
    "version": [
      {
        "version": "v1.0.0",
        "release_date": "2026-09-18",
        "file": [
          {
            "path": "{pluginsDir}/SYNC_MapRaku/SYNC_MapRaku_Filter.auf2"
          }
        ]
      }
    ]
  }
]
